<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories - FootNotes</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-amber-50 text-gray-800">

    <%- include('includes/nav.ejs') %>

    <div class="text-center mt-10 mb-8">
        <h1 class="text-4xl font-bold text-red-900">
            Book Categories
        </h1>

        <p class="text-gray-600 mt-3">
            Choose a category and find books you like.
        </p>
    </div>

    <div class="flex flex-wrap justify-center gap-3 px-6 mb-12">

        <a href="/categories"
           class="bg-red-900 text-white px-5 py-2 rounded hover:bg-red-800">
            All Books
        </a>

        <a href="/categories/self-help"
           class="bg-white border border-red-900 text-red-900 px-5 py-2 rounded hover:bg-red-900 hover:text-white">
            Self Help
        </a>

        <a href="/categories/learning"
           class="bg-white border border-red-900 text-red-900 px-5 py-2 rounded hover:bg-red-900 hover:text-white">
            Learning
        </a>

        <a href="/categories/fantasy"
           class="bg-white border border-red-900 text-red-900 px-5 py-2 rounded hover:bg-red-900 hover:text-white">
            Fantasy
        </a>

    </div>

    <main class="px-6 md:px-8 pb-16">

        <% if (books.length > 0) { %>

            <h2 class="text-2xl font-bold text-red-900 mb-6">
                Available Books
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                <% books.forEach(book => { %>

                    <div class="bg-white border border-gray-300 rounded-lg p-5 shadow">

                        <% 
                            let bookImage = book.image || book.img || "";

                            if (
                                bookImage &&
                                !bookImage.startsWith("http://") &&
                                !bookImage.startsWith("https://")
                            ) {
                                bookImage = "/" + bookImage.replace(/^\/+/, "");
                            }
                        %>

                        <% if (bookImage) { %>

                            <img
                                src="<%= bookImage %>"
                                alt="<%= book.title %>"
                                class="w-full h-60 object-contain rounded mb-4 bg-gray-100"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">

                            <div class="w-full h-60 bg-gray-200 rounded mb-4 items-center justify-center"
                                 style="display:none;">
                                <p class="text-gray-500">Image not found</p>
                            </div>

                        <% } else { %>

                            <div class="w-full h-60 bg-gray-200 rounded mb-4 flex items-center justify-center">
                                <p class="text-gray-500">No Image Available</p>
                            </div>

                        <% } %>

                        <h3 class="text-xl font-bold text-red-900 mb-2">
                            <%= book.title %>
                        </h3>

                        <p class="text-gray-700 mb-2">
                            <span class="font-semibold">Author:</span>
                            <%= book.author %>
                        </p>

                        <p class="text-gray-700 mb-2">
                            <span class="font-semibold">Price:</span>
                            ₹<%= book.price %>
                        </p>

                        <p class="text-gray-700">
                            <span class="font-semibold">Category:</span>
                            <%= book.category %>
                        </p>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <div class="text-center bg-white border border-gray-300 rounded-lg p-10">

                <h2 class="text-2xl font-bold text-red-900 mb-3">
                    No Books Found
                </h2>

                <p class="text-gray-600">
                    There are no books available in this category.
                </p>

                <a href="/categories"
                   class="inline-block mt-5 bg-red-900 text-white px-5 py-2 rounded hover:bg-red-800">
                    View All Books
                </a>

            </div>

        <% } %>

    </main>

    <%- include('includes/footer.ejs') %>

</body>
</html>