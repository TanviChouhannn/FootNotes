<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Book - FootNotes</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body class="bg-amber-50 text-gray-800">

    <%- include('includes/nav.ejs') %>

    <section class="px-6 py-12">

        <div class="max-w-2xl mx-auto">

            <div class="text-center mb-10">

                <p class="text-red-900 uppercase tracking-widest text-sm mb-3">
                    The Collection
                </p>

                <h1 class="text-4xl font-bold text-red-900">
                    Add New Book
                </h1>

                <p class="text-gray-600 mt-3">
                    Add a new book to the FootNotes collection.
                </p>

            </div>

            <form
                action="/books"
                method="POST"
                enctype="multipart/form-data"
                class="bg-white border border-gray-300 rounded-lg shadow p-8">

                <div class="mb-6">

                    <label
                        for="title"
                        class="block font-semibold text-gray-700 mb-2">
                        Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        placeholder="Enter book title"
                        required
                        class="w-full border border-gray-300 rounded px-4 py-3 outline-none focus:border-red-900">

                </div>

                <div class="mb-6">

                    <label
                        for="author"
                        class="block font-semibold text-gray-700 mb-2">
                        Author
                    </label>

                    <input
                        type="text"
                        id="author"
                        name="author"
                        placeholder="Enter author name"
                        required
                        class="w-full border border-gray-300 rounded px-4 py-3 outline-none focus:border-red-900">

                </div>

                <div class="mb-6">

                    <label
                        for="price"
                        class="block font-semibold text-gray-700 mb-2">
                        Price
                    </label>

                    <input
                        type="number"
                        id="price"
                        name="price"
                        placeholder="Enter book price"
                        required
                        class="w-full border border-gray-300 rounded px-4 py-3 outline-none focus:border-red-900">

                </div>

                <div class="mb-6">

                    <label
                        for="category"
                        class="block font-semibold text-gray-700 mb-2">
                        Category
                    </label>

                    <select
                        id="category"
                        name="category"
                        required
                        class="w-full border border-gray-300 rounded px-4 py-3 bg-white outline-none focus:border-red-900">

                        <option value="">
                            Select Category
                        </option>

                        <option value="Fiction">
                            Fiction
                        </option>

                        <option value="Fantasy">
                            Fantasy
                        </option>

                        <option value="Mystery">
                            Mystery
                        </option>

                        <option value="Academics">
                            Academics
                        </option>

                        <option value="Science">
                            Science
                        </option>

                        <option value="Biography">
                            Biography
                        </option>

                        <option value="Self Help">
                            Self Help
                        </option>

                        <option value="Learning">
                            Learning
                        </option>

                    </select>

                </div>

                
<div class="mb-8">
    <label
        for="img"
        class="block font-semibold text-gray-700 mb-2">
        Book Image
    </label>

    <input
        type="file"
        id="img"
        name="img"
        accept=".jpg,.jpeg,.png,.gif,.webp,.svg,.bmp,.tif,.tiff,.ico,.avif,image/*"
        required
        class="w-full border border-gray-300 rounded px-4 py-3 bg-amber-50">
</div>


                <div class="flex gap-3">

                    <button
                        type="submit"
                        class="bg-red-900 text-white px-6 py-3 rounded hover:bg-red-800">
                        Add Book
                    </button>

                    <a
                        href="/books"
                        class="border border-red-900 text-red-900 px-6 py-3 rounded hover:bg-red-900 hover:text-white">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </section>

    <%- include('includes/footer.ejs') %>

</body>

</html>