<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cart - FootNotes</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body class="bg-amber-50 text-gray-800">

    <%- include('includes/nav.ejs') %>

    <section class="px-6 py-12">

        <div class="max-w-5xl mx-auto">

            <div class="text-center mb-10">

                <h1 class="text-4xl font-bold text-red-900">
                    Your Cart
                </h1>

                <p class="text-gray-600 mt-3">
                    Review your selected books.
                </p>

            </div>

            <% if (cart.length === 0) { %>

                <div class="bg-white border border-gray-300 rounded-lg p-10 text-center">

                    <h2 class="text-2xl font-bold text-red-900 mb-3">
                        Your Cart is Empty
                    </h2>

                    <a
                        href="/books"
                        class="inline-block bg-red-900 text-white px-6 py-3 rounded hover:bg-red-800">
                        Browse Books
                    </a>

                </div>

            <% } else { %>

                <div class="space-y-4">

                    <% cart.forEach(item => { %>

                        <div class="bg-white border border-gray-300 rounded-lg p-5 flex flex-col md:flex-row gap-5 items-center">

                            
<img
    src="<%= item.image %>"
    alt="<%= item.title %>"
    class="w-24 h-32 object-cover rounded">


                            <div class="flex-1">

                                <h2 class="text-xl font-bold text-red-900">
                                    <%= item.title %>
                                </h2>

                                <p class="text-gray-600">
                                    <%= item.author %>
                                </p>

                                <p class="font-semibold mt-2">
                                    ₹<%= item.price %>
                                </p>

                            </div>

                            <div class="flex items-center gap-2">

                                <form action="/cart/decrease/<%= item.bookId %>" method="POST">

                                    <button
                                        class="border border-gray-400 px-3 py-1 rounded">
                                        −
                                    </button>

                                </form>

                                <span class="px-3">
                                    <%= item.quantity %>
                                </span>

                                <form action="/cart/increase/<%= item.bookId %>" method="POST">

                                    <button
                                        class="border border-gray-400 px-3 py-1 rounded">
                                        +
                                    </button>

                                </form>

                            </div>

                            <form action="/cart/remove/<%= item.bookId %>" method="POST">

                                <button
                                    class="text-red-900 hover:underline">
                                    Remove
                                </button>

                            </form>

                        </div>

                    <% }) %>

                </div>

                <div class="bg-white border border-gray-300 rounded-lg p-6 mt-6 text-right">

                    <h2 class="text-2xl font-bold text-red-900">
                        Total: ₹<%= total %>
                    </h2>

                    <p class="text-gray-500 mt-2">
                        Checkout is available for Buy Now orders.
                    </p>

                </div>

            <% } %>

        </div>

    </section>

    <%- include('includes/footer.ejs') %>

</body>

</html>