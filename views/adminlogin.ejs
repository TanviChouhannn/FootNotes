<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - FootNotes</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-amber-50 text-gray-800">

    <%- include('includes/nav.ejs') %>

    <section class="min-h-[75vh] flex items-center justify-center px-6 py-12">

        <div class="w-full max-w-md">

            <div class="text-center mb-8">

                <p class="text-red-900 uppercase tracking-widest text-sm mb-3">
                    FootNotes
                </p>

                <h1 class="text-4xl font-bold text-red-900">
                    Admin Login
                </h1>

                <p class="text-gray-600 mt-3">
                    Login to manage your books.
                </p>

            </div>

            <div class="bg-white border border-gray-300 rounded-lg shadow p-8">

                <form action="/admin/login" method="POST">

                    <div class="mb-5">

                        <label
                            for="username"
                            class="block font-semibold text-gray-700 mb-2">
                            Username
                        </label>

                        <input
                            type="text"
                            id="username"
                            name="username"
                            placeholder="Enter username"
                            required
                            class="w-full border border-gray-300 rounded px-4 py-3 outline-none focus:border-red-900">

                    </div>

                    <div class="mb-6">

                        <label
                            for="password"
                            class="block font-semibold text-gray-700 mb-2">
                            Password
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter password"
                            required
                            class="w-full border border-gray-300 rounded px-4 py-3 outline-none focus:border-red-900">

                    </div>

                    <button
                        type="submit"
                        class="w-full bg-red-900 text-white py-3 rounded hover:bg-red-800">
                        Login
                    </button>

                </form>

                <div class="text-center mt-6">

                    <a
                        href="/"
                        class="text-red-900 hover:underline">
                        ← Back to Home
                    </a>

                </div>

            </div>

        </div>

    </section>

    <%- include('includes/footer.ejs') %>

</body>

</html>