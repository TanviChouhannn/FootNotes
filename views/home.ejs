<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FootNotes - Bookstore</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-[#f5eee6] text-[#3b1717]">
    <%- include('includes/nav.ejs') %>

    <div class="min-h-[calc(100vh-70px)] flex items-center px-8 md:px-16 lg:px-24">
        <div class="box flex flex-col md:flex-row items-center justify-between gap-12 w-full max-w-7xl mx-auto">
            <div class="b1 w-full md:w-1/2 text-center md:text-left">
                <p class="text-[#8b5e3c] text-lg font-medium tracking-widest uppercase mb-4">
                    Welcome to
                </p>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
                    Our Bookstore
                </h1>
                <h2 class="text-3xl md:text-4xl font-serif font-semibold mt-2 text-[#6b1f1f]">
                    FootNotes
                </h2>
                <div class="w-20 h-1 bg-[#6b1f1f] mt-6 mb-6 mx-auto md:mx-0 rounded-full"></div>
                <p class="text-lg md:text-xl leading-8 text-[#5c4640] max-w-xl">
                    Welcome to FootNotes, your cozy corner for stories,
                    knowledge, and imagination. Discover books that inspire,
                    entertain, and take you to new worlds.
                </p>
                <p class="text-lg md:text-xl leading-8 text-[#5c4640] max-w-xl mt-4">
                    Whether you're looking for a timeless classic, an exciting
                    new story, or something to learn from, there's always a
                    perfect book waiting for you.
                </p>
                <div class="mt-8 flex gap-4 justify-center md:justify-start">
                    <a href="/books"
                        class="px-7 py-3 bg-[#6b1f1f] text-white rounded-full font-semibold hover:bg-[#4d1515] transition duration-300 shadow-md">
                        Explore Books
                    </a>
                    <a href="/about"
                        class="px-7 py-3 border-2 border-[#6b1f1f] text-[#6b1f1f] rounded-full font-semibold hover:bg-[#6b1f1f] hover:text-white transition duration-300">
                        About Us
                    </a>
                </div>
            </div>
            <div class="b2 w-full md:w-1/2 flex justify-center md:justify-end">
                    <img src="/uploads/home.jpg"
                        alt="Books"
                        class="w-[350px] md:w-[430px] lg:w-[500px] h-[420px] md:h-[500px] object-cover rounded-3xl shadow-2xl">
            </div>
        </div>
    </div>
    <%- include('includes/footer.ejs') %>
</body>
</html>