<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Book - FootNotes</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body class="bg-amber-50 text-gray-800">

    <%- include('includes/nav.ejs') %>

    <section class="px-6 py-12">

        <div class="max-w-3xl mx-auto">

            <div class="text-center mb-10">

                <p class="text-red-900 uppercase tracking-widest text-sm mb-3">
                    The Collection
                </p>

                <h1 class="text-4xl font-bold text-red-900">
                    Edit Book
                </h1>

                <p class="text-gray-600 mt-3">
                    Update the details of your book.
                </p>

            </div>

            <form
                action="/books/edit/<%= book._id %>"
                method="POST"
                enctype="multipart/form-data"
                class="bg-white border border-gray-300 rounded-lg shadow p-8">

                <div class="mb-6">

                    <label
                        for="title"
                        class="block font-semibold text-gray-700 mb-2">
                        Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        value="<%= book.title %>"
                        required
                        class="w-full border border-gray-300 rounded px-4 py-3 outline-none focus:border-red-900">

                </div>

                <div class="mb-6">

                    <label
                        for="author"
                        class="block font-semibold text-gray-700 mb-2">
                        Author
                    </label>

                    <input
                        type="text"
                        id="author"
                        name="author"
                        value="<%= book.author %>"
                        required
                        class="w-full border border-gray-300 rounded px-4 py-3 outline-none focus:border-red-900">

                </div>

                <div class="mb-6">

                    <label
                        for="price"
                        class="block font-semibold text-gray-700 mb-2">
                        Price
                    </label>

                    <input
                        type="number"
                        id="price"
                        name="price"
                        value="<%= book.price %>"
                        required
                        class="w-full border border-gray-300 rounded px-4 py-3 outline-none focus:border-red-900">

                </div>

                <div class="mb-6">

                    <label
                        for="category"
                        class="block font-semibold text-gray-700 mb-2">
                        Category
                    </label>

                    <select
                        id="category"
                        name="category"
                        required
                        class="w-full border border-gray-300 rounded px-4 py-3 outline-none focus:border-red-900">

                        <option value="Fiction" <%= book.category === "Fiction" ? "selected" : "" %>>
                            Fiction
                        </option>

                        <option value="Fantasy" <%= book.category === "Fantasy" ? "selected" : "" %>>
                            Fantasy
                        </option>

                        <option value="Mystery" <%= book.category === "Mystery" ? "selected" : "" %>>
                            Mystery
                        </option>

                        <option value="Academics" <%= book.category === "Academics" ? "selected" : "" %>>
                            Academics
                        </option>

                        <option value="Science" <%= book.category === "Science" ? "selected" : "" %>>
                            Science
                        </option>

                        <option value="Biography" <%= book.category === "Biography" ? "selected" : "" %>>
                            Biography
                        </option>

                        <option value="Self Help" <%= book.category === "Self Help" ? "selected" : "" %>>
                            Self Help
                        </option>

                        <option value="Learning" <%= book.category === "Learning" ? "selected" : "" %>>
                            Learning
                        </option>

                    </select>

                </div>

                <div class="mb-6">

                    <label class="block font-semibold text-gray-700 mb-3">
                        Current Image
                    </label>

                    <% if (book.image || book.img) { %>

                        <img
                            src="<%= book.image || '/' + book.img %>"
                            alt="<%= book.title %>"
                            class="w-40 h-52 object-cover rounded border border-gray-300">

                    <% } else { %>

                        <div class="w-40 h-52 bg-gray-200 rounded flex items-center justify-center">
                            <p class="text-gray-500 text-sm">
                                No Image
                            </p>
                        </div>

                    <% } %>

                </div>

                <div class="mb-8">

                    <label
                        for="img"
                        class="block font-semibold text-gray-700 mb-2">
                        New Image
                    </label>

                    <input
                        type="file"
                        id="img"
                        name="img"
                        accept="image/*"
                        class="w-full border border-gray-300 rounded px-4 py-3 bg-amber-50">

                    <p class="text-sm text-gray-500 mt-2">
                        Leave empty if you want to keep the current image.
                    </p>

                </div>

                <div class="flex gap-3">

                    <button
                        type="submit"
                        class="bg-red-900 text-white px-6 py-3 rounded hover:bg-red-800">
                        Update Book
                    </button>

                    <a
                        href="/books"
                        class="border border-red-900 text-red-900 px-6 py-3 rounded hover:bg-red-900 hover:text-white">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </section>

    <%- include('includes/footer.ejs') %>

</body>

</html>