<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Books - FootNotes</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-amber-50 text-gray-800">

    <%- include('includes/nav.ejs') %>

    <section class="px-6 py-12">
        <div class="max-w-7xl mx-auto">

            <div class="text-center mb-10">
                <p class="text-red-900 uppercase tracking-widest text-sm mb-3">
                    The Collection
                </p>

                <h1 class="text-4xl font-bold text-red-900">
                    Our Books
                </h1>

                <p class="text-gray-600 mt-3">
                    Explore our collection of books.
                </p>
            </div>

            <% if (isAdmin) { %>
                <div class="flex justify-end gap-3 mb-8">
                    <a href="/books/new"
                       class="bg-red-900 text-white px-5 py-2 rounded hover:bg-red-800">
                        Add New Book
                    </a>

                    <a href="/admin/logout"
                       class="border border-red-900 text-red-900 px-5 py-2 rounded hover:bg-red-900 hover:text-white">
                        Logout
                    </a>
                </div>
            <% } %>

            <% if (books.length === 0) { %>

                <div class="bg-white border border-gray-300 rounded-lg p-10 text-center">
                    <h2 class="text-2xl font-bold text-red-900 mb-2">
                        No Books Found
                    </h2>

                    <p class="text-gray-600">
                        There are no books available right now.
                    </p>
                </div>

            <% } else { %>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                    <% books.forEach(book => { %>

                        <div class="bg-white border border-gray-300 rounded-lg shadow p-5">

                            <% 
                                let bookImage = book.image || book.img || "";

                                if (bookImage && !bookImage.startsWith("http://") && !bookImage.startsWith("https://")) {
                                    bookImage = "/" + bookImage.replace(/^\/+/, "");
                                }
                            %>

                            <% if (bookImage) { %>

                                <img
                                    src="<%= bookImage %>"
                                    alt="<%= book.title %>"
                                    class="w-full h-64 object-contain rounded mb-5 bg-gray-100"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">

                                <div class="w-full h-64 bg-gray-200 rounded mb-5 items-center justify-center"
                                     style="display:none;">
                                    <p class="text-gray-500">Image not found</p>
                                </div>

                            <% } else { %>

                                <div class="w-full h-64 bg-gray-200 rounded mb-5 flex items-center justify-center">
                                    <p class="text-gray-500">No Image Available</p>
                                </div>

                            <% } %>

                            <p class="text-red-900 text-sm uppercase tracking-wider mb-2">
                                <%= book.category || "Uncategorized" %>
                            </p>

                            <h2 class="text-2xl font-bold text-red-900 mb-4">
                                <%= book.title %>
                            </h2>

                            <p class="text-gray-700 mb-2">
                                <span class="font-semibold">Author:</span>
                                <%= book.author %>
                            </p>

                            <p class="text-gray-700 mb-4">
                                <span class="font-semibold">Price:</span>
                                ₹<%= book.price %>
                            </p>

                            <div class="flex flex-col gap-2">

                                <form action="/cart/add/<%= book._id %>" method="POST">
                                    <button
                                        type="submit"
                                        class="w-full border border-red-900 text-red-900 px-4 py-2 rounded hover:bg-red-900 hover:text-white">
                                        Add to Cart
                                    </button>
                                </form>

                                <form action="/cart/add/<%= book._id %>" method="POST">
                                    <button
                                        type="submit"
                                        class="w-full bg-red-900 text-white px-4 py-2 rounded hover:bg-red-800">
                                        Buy Now
                                    </button>
                                </form>

                            </div>

                            <% if (isAdmin) { %>

                                <div class="border-t border-gray-300 pt-4 mt-4 flex gap-3">

                                    <a href="/books/edit/<%= book._id %>"
                                       class="border border-red-900 text-red-900 px-4 py-2 rounded hover:bg-red-900 hover:text-white">
                                        Edit
                                    </a>

                                    <form action="/books/delete/<%= book._id %>" method="POST">
                                        <button
                                            type="submit"
                                            onclick="return confirm('Are you sure you want to delete this book?')"
                                            class="bg-red-900 text-white px-4 py-2 rounded hover:bg-red-800">
                                            Delete
                                        </button>
                                    </form>

                                </div>

                            <% } %>

                        </div>

                    <% }) %>

                </div>

            <% } %>

        </div>
    </section>

    <%- include('includes/footer.ejs') %>

</body>
</html>